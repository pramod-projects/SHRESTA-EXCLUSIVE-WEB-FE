# Independent local DEV template. Copy to .env.dev; do not commit secrets.
# NEXT_PUBLIC_* values are compiled into browser code. All other values remain server-only.

# Typed mode shown by /api/health and used for environment-specific security behavior.
SHRESTA_ENVIRONMENT_MODE=DEV
# Browser-visible canonical storefront and admin origins.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3010
NEXT_PUBLIC_ADMIN_URL=http://localhost:3010/admin
# Browser-visible customer support contacts.
NEXT_PUBLIC_SHRESTA_SUPPORT_EMAIL=support@shrestaexclusive.com
NEXT_PUBLIC_SHRESTA_SUPPORT_PHONE_DISPLAY="+91 12345 67890"
NEXT_PUBLIC_SHRESTA_SUPPORT_PHONE_DIAL=+911234567890
# Server-side backend origin used by route handlers and server components.
SHRESTA_API_BASE_URL=http://localhost:8090
# Server-only key used by the Next admin bridge. It must match the backend value.
SHRESTA_ADMIN_API_KEY=local-shresta-admin-key
# Signs the HTTP-only admin session cookie. Use a long random value outside local DEV.
SHRESTA_ADMIN_SESSION_SECRET=change-me-local-session-secret
# Browser-visible API origin for client requests that are intentionally public.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8090
# Browser-visible media origin. DEV points to MinIO; UAT/PROD point to Cloudflare domains.
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9010
# Client preflight limits mirror backend signing limits; backend validation remains authoritative.
NEXT_PUBLIC_MEDIA_CANONICAL_MAX_WIDTH=2400
NEXT_PUBLIC_MEDIA_CANONICAL_MAX_HEIGHT=3200
NEXT_PUBLIC_MEDIA_CANONICAL_MAX_FILE_SIZE=15000000
# Razorpay key ID is public by design. Never put RAZORPAY_KEY_SECRET in the frontend.
NEXT_PUBLIC_RAZORPAY_KEY_ID=YOUR_PUBLIC_DEV_RAZORPAY_KEY_ID

# NODE_ENV is set by Next.js commands; do not add it manually to environment files.

# UAT and PROD use their independent templates or equivalent Vercel environment variables.
# SHRESTA_ADMIN_API_KEY=<same value configured in backend env>
# NEXT_PUBLIC_RAZORPAY_KEY_ID=<public razorpay key id only; never include key secret in frontend env>
