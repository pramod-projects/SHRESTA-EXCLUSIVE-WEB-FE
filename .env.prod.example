# Independent PROD/Vercel template. Copy to .env.prod for non-Vercel runtime use.
# NEXT_PUBLIC_* values are browser-visible; other values are server-only.
# Never reuse UAT credentials, session secrets, or media domains here.

# Typed mode and canonical browser-visible origins.
SHRESTA_ENVIRONMENT_MODE=PROD
NEXT_PUBLIC_STOREFRONT_URL=https://shrestaexclusive.com
NEXT_PUBLIC_ADMIN_URL=https://admin.shrestaexclusive.com
# Browser-visible customer support contacts.
NEXT_PUBLIC_SHRESTA_SUPPORT_EMAIL=support@shrestaexclusive.com
NEXT_PUBLIC_SHRESTA_SUPPORT_PHONE_DISPLAY="+91 12345 67890"
NEXT_PUBLIC_SHRESTA_SUPPORT_PHONE_DIAL=+911234567890
# Server components use the private server value; browser code uses NEXT_PUBLIC_API_BASE_URL.
SHRESTA_API_BASE_URL=https://api.shrestaexclusive.com
NEXT_PUBLIC_API_BASE_URL=https://api.shrestaexclusive.com
# Cloudflare custom media read domain. This is not the R2 S3 API endpoint.
NEXT_PUBLIC_MEDIA_BASE_URL=https://YOUR_PROD_MEDIA_DOMAIN
# Browser preflight limits mirror backend signing limits; bytes are used for file size.
NEXT_PUBLIC_MEDIA_CANONICAL_MAX_WIDTH=2400
NEXT_PUBLIC_MEDIA_CANONICAL_MAX_HEIGHT=3200
NEXT_PUBLIC_MEDIA_CANONICAL_MAX_FILE_SIZE=15000000
# Server-only admin bridge key and cookie-signing secret. Use long random values.
SHRESTA_ADMIN_API_KEY=YOUR_SERVER_ONLY_ADMIN_API_KEY
SHRESTA_ADMIN_SESSION_SECRET=YOUR_SERVER_ONLY_SESSION_SECRET
# Public Razorpay key ID only; the secret belongs exclusively in backend configuration.
NEXT_PUBLIC_RAZORPAY_KEY_ID=YOUR_PUBLIC_PROD_RAZORPAY_KEY_ID
